// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  bio          String?
  avatarUrl    String?
  trips        Trip[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Trip {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  destination   String
  budgetLevel   String    @default("moderate")
  interests     String?
  durationDays  Int
  startDate     DateTime?
  endDate       DateTime?
  coverImageUrl String?
  status        String    @default("draft")
  days          Day[]
  bookings      Booking[]
  collaborators Collaborator[]
  journalEntries JournalEntry[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model JournalEntry {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber Int?
  title     String
  content   String
  photoUrl  String?
  rating    Int?     @default(5)
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collaborator {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  email     String
  role      String   @default("editor") // editor | viewer
  avatarUrl String?
  createdAt DateTime @default(now())
}

model Booking {
  id             String   @id @default(cuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type           String   // flight | hotel | train | car | activity | other
  title          String
  confirmationNo String?
  provider       String?
  dateTime       String?
  location       String?
  cost           Float?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Day {
  id         String     @id @default(cuid())
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber  Int
  date       DateTime?
  summary    String?
  activities Activity[]
}

model Activity {
  id          String  @id @default(cuid())
  dayId       String
  day         Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  time        String
  title       String
  description String
  location    String
  latitude    Float?
  longitude   Float?
  category    String?
  isCompleted Boolean @default(false)
}

model Destination {
  id                 String   @id @default(cuid())
  name               String   @unique
  state              String
  unionTerritory     String?
  city               String
  latitude           Float
  longitude          Float
  description        String
  category           String   // e.g. Heritage, Spiritual, Hill Stations, Beaches, Wildlife, Adventure
  subcategories      String   // Comma-separated list
  bestTimeToVisit    String
  idealDuration      String   // e.g. "3-4 days"
  budgetLevel        String   // "budget" | "moderate" | "luxury"
  estimatedDailyCost Int      // in INR (₹)
  popularActivities  String   // JSON string
  attractions        String   // JSON string
  foodSpecialties    String   // JSON string
  localLanguages     String
  culture            String
  safetyInformation  String
  transportation     String
  nearbyDestinations String   // Comma-separated
  hiddenGem          Boolean  @default(false)
  familyFriendly     Boolean  @default(true)
  honeymoonFriendly  Boolean  @default(false)
  backpackerFriendly Boolean  @default(true)
  soloFriendly       Boolean  @default(true)
  adventureFriendly  Boolean  @default(false)
  spiritual          Boolean  @default(false)
  heritage           Boolean  @default(false)
  nature             Boolean  @default(false)
  beach              Boolean  @default(false)
  wildlife           Boolean  @default(false)
  nightlife          Boolean  @default(false)
  shopping           Boolean  @default(false)
  food               Boolean  @default(false)
  imageUrl           String
  imageQuery         String?
  rating             Float    @default(4.6)
  reviewsCount       Int      @default(350)
  popularityScore    Int      @default(80)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([state])
  @@index([category])
  @@index([hiddenGem])
}

model Festival {
  id               String   @id @default(cuid())
  name             String   @unique
  state            String   // State or "All India"
  celebrationMonth String   // e.g. "October - November"
  significance     String
  traditions       String
  famousPlaces     String   // Destinations celebrated best in
  imageUrl         String?
  createdAt        DateTime @default(now())
}

